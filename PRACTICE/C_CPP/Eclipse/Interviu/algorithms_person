#include <iostream>
#include <string>

struct Person
{
  string name;
  int age;

  friend ostream& operator<<(ostream& os, const Person& p)
  {
    return os << p.name << " is " << p.age << " years old.";
  }
};

int main(){
  vector<Person> people { {"John", 27}, {"Chris", 24}, {"Ann", 31}};

  auto print_all = [&]() {
    cout << people.size() << " persons:" << endl;
    for_each(begin(people), end(people),
    [](const Person& p) { cout << p << endl;});
  };
  print_all();

  auto oldest = *max_element(people.begin(), people.end().
  [](const Person& a, const Person& b)
  {
  return a.age < b.age;
  });
  cout << oldest.name << " is the oldest" << endl;

  auto john = find_if(people.begin(), people.end(),
  [](const Person& p){
    return p.name == string("John");
  });
  if (john != people.end()) {
    cout << "Found " << john->name << " who is " << john.age << endl;
  }
  getchar();
  return 0;
}
